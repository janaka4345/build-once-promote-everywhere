# Copy to .env and adjust to match database/.env.local (or .env.sample) credentials/port.
# Do not symlink or share this file with database compose env.
#
# Host-run API against compose-published Postgres:
DATABASE_URL=postgresql+psycopg://admin:template_db_dev_password@localhost:5432/template_db
#
# If connections hang on Windows, try host 127.0.0.1 instead of localhost.
