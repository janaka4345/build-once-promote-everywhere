# Copy to .env and adjust as needed:
#   cp .env.sample .env.local
#
# Used by: docker-compose-pgvector-latest.yml
# (compose loads .env automatically from this directory)

# --- Postgres ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=template_db_dev_password
POSTGRES_DB=template_db
POSTGRES_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Optional services (uncomment matching blocks in compose to use) ---
# POSTGRES_MCP_PORT=8001
# QDRANT_API_KEY=
# QDRANT_PORT=6333
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001
# REDIS_PORT=6379
# REDISINSIGHT_PORT=5540
